{
  "realm": "aurae",
  "displayName": "Aurae (local development)",
  "enabled": true,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "mfa", "description": "Medical assistant: uploads and confirms outside reports" },
      { "name": "gp", "description": "GP: sees values from all sources" },
      { "name": "admin", "description": "Practice admin: users, settings and audit log" }
    ]
  },
  "clients": [
    {
      "clientId": "aurae-web",
      "name": "Aurae",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__CLIENT_SECRET__",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/oidc",
        "http://localhost:5173/login/oauth2/code/oidc"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles as roles claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "mfa.test",
      "enabled": true,
      "firstName": "Test",
      "lastName": "Assistant",
      "email": "mfa.test@example.invalid",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "__MFA_PASSWORD__", "temporary": false }],
      "realmRoles": ["mfa"]
    },
    {
      "username": "gp.test",
      "enabled": true,
      "firstName": "Test",
      "lastName": "Doctor",
      "email": "gp.test@example.invalid",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "__GP_PASSWORD__", "temporary": false }],
      "realmRoles": ["gp"]
    },
    {
      "username": "admin.test",
      "enabled": true,
      "firstName": "Test",
      "lastName": "Admin",
      "email": "admin.test@example.invalid",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "__ADMIN_PASSWORD__", "temporary": false }],
      "realmRoles": ["admin"]
    }
  ]
}
