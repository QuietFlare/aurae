# Copy to .env and fill in. Git ignores .env and every .env.* file except this one.

# Which identity provider runs. Swap the second file to switch:
#   compose.yaml:compose.keycloak.yaml   bundled Keycloak
#   compose.yaml:compose.cognito.yaml    AWS Cognito test pool (needs .env.cognito from Terraform)
COMPOSE_FILE=compose.yaml:compose.keycloak.yaml

# The name staff type into the browser, without https://. make-cert.sh takes the same name.
AURAE_HOST=aurae.localhost

POSTGRES_PASSWORD=

# Only for compose.keycloak.yaml. Generate each with: openssl rand -hex 24
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
