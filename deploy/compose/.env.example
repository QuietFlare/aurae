# Copy to .env and fill in. .env is never committed.

# Address of Keycloak as the browser sees it. For a local trial: http://keycloak.localhost:8180
KEYCLOAK_URL=

POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=

# Must match the aurae-web client secret in the Keycloak realm.
AURAE_OIDC_CLIENT_SECRET=

# false only for a local trial over plain http.
SECURE_COOKIES=true
