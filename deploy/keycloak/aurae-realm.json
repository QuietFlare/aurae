{
  "realm": "aurae",
  "displayName": "Aurae",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "all",
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 36000,
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    }
  ],
  "roles": {
    "realm": [
      { "name": "mfa", "description": "Medical assistant: uploads and confirms outside reports" },
      { "name": "gp", "description": "GP: sees values from all sources" },
      { "name": "admin", "description": "Practice admin: users, settings and audit log" }
    ]
  },
  "clients": [
    {
      "clientId": "aurae-web",
      "name": "Aurae",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:KEYCLOAK_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "rootUrl": "$(env:AURAE_URL)",
      "redirectUris": ["$(env:AURAE_URL)/login/oauth2/code/oidc"],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "$(env:AURAE_URL)/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles as roles claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
